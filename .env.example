# 분석 제공자: demo, gemini, openai
LLM_PROVIDER=demo

# Gemini 모드
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI 모드
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 로컬 인증. 실제 실행 시 32자 이상의 임의 값이 필요합니다.
JWT_SECRET=
AUTH_COOKIE_SECURE=false

# SQLite 경로를 비워두면 backend/blockwill.db를 사용합니다.
BLOCKWILL_DATABASE_PATH=

# 백엔드와 프론트엔드 개발 서버
API_PORT=8001
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
