# 이 예시 파일은 Git에 커밋합니다. 실제 값은 복사한 .env에만 입력합니다.
# demo: 외부 API 호출 없이 규칙 기반 분석. API 키가 필요 없습니다.
LLM_PROVIDER=demo
# openai 모드에서만 아래 두 값이 필요합니다.
# OPENAI_API_KEY는 비밀값입니다. 이 파일에 실제 키를 넣지 마세요.
OPENAI_API_KEY=
# 본인 API 계정에서 사용 가능한 Structured Outputs 지원 모델 ID.
# 모델 ID 자체는 비밀이 아니지만 실행 환경별로 선택합니다.
OPENAI_MODEL=
# 현재 코드는 RPC_URL, PRIVATE_KEY, DATABASE_URL을 사용하지 않습니다.
# 지갑 개인키나 복구 문구를 AI API 환경변수에 넣지 마세요.
